{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tanstack/react-router": [
        "./src/lib/router-bridge.tsx"
      ],
      "@tanstack/react-start": [
        "./src/lib/server-fn-bridge.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backup",
    "src/router.tsx",
    "src/server.ts",
    "src/start.ts",
    "src/routeTree.gen.ts",
    "src/routes/__root.tsx",
    "src/routes/homedelivery.tsx",
    "src/routes/shop.tsx",
    "src/routes/sitemap[.]xml.ts"
  ]
}
